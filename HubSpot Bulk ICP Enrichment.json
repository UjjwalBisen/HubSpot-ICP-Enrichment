      "typeVersion": 3,
      "position": [
        672,
        192
      ],
      "id": "669a48a2-6041-454a-8670-1a972fa1d91f",
      "name": "Loop Over Items"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/webhook/enrich",
