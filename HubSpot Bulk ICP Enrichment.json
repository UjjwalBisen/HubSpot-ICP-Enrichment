    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/companies/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer pat-na2-57b18d6b-a85a-4d62-be59-e6ea31f5a128"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  filterGroups: [\n    {\n      filters: [\n        {\n          propertyName: \"icp_score\",\n          operator: \"NOT_HAS_PROPERTY\"\n        }\n      ]\n    }\n  ],\n  properties: [\"name\", \"domain\", \"website\"],\n  limit: 20\n}) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        224,
        192
      ],
      "id": "dc7cd0c9-3a19-4942-a742-3841c0b37f85",
      "name": "Fetch All Companies"
    },
    {
      "parameters": {
        "jsCode": "// Get the input from Fetch All Companies\nconst items = $input.all();\nconst response = items && items.length > 0 ? items[0].json : {};\n\nconst companies = response.results || [];\n\nconsole.log(`Found ${companies.length} companies to enrich`);\n\nif (companies.length === 0) {\n  return [{\n    json: {\n      message: \"No companies need enrichment\",\n      total: 0\n    }\n  }];\n}\n\n// Convert each company into an individual item\nreturn companies.map(company => ({\n  json: {\n    company_id: company.id,\n    name: company.properties?.name || 'Unknown',\n    domain: company.properties?.domain || '',\n    website: company.properties?.website || ''\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        192
      ],
      "id": "03b632b1-ea78-48fd-b1e4-634ec99a5726",
      "name": "Split Companies"
    },
    {
      "parameters": {
        "options": {}
      },
